#############################################
# Invoyo Environment Example
# Copy this file to .env and adjust values.
# Works out-of-the-box with Docker Compose.
#############################################

# App
APP_NAME=Invoyo
# development | staging | production
ENVIRONMENT=development

# Security
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database - PostgreSQL
# Docker Compose (service hostname: db)
DATABASE_URL=postgresql://user:password@db:5432/invoyo
# Local/Prod examples (uncomment and update):
# DATABASE_URL=postgresql://user:password@localhost:5432/invoyo
# DATABASE_URL=postgresql://user:password@db.example.com:5432/invoyo
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=30

# OCR API (placeholder key)
OCR_API_KEY=sk_test_12345

# File uploads
MAX_UPLOAD_SIZE_MB=50
# Inside API container; make sure to mount/persist this in prod
UPLOAD_DIRECTORY=/home/app/app/data/storage

# Redis / Celery
# Docker Compose (service hostname: redis)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Local/Prod examples (uncomment and update):
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=INFO
